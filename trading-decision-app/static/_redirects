# Cloudflare Pages SPA fallback + API proxy.
#
# Order matters: API rules must come BEFORE the catch-all SPA rewrite,
# otherwise /api/* requests would be rewritten to /index.html and never
# reach the Fly backend.

# Proxy API + SSE traffic to backend
/api/*  https://trading-decision-app.fly.dev/api/:splat  200

# SPA fallback — every other path serves the app shell so the JS Router
# can paint the correct tab from location.pathname.
/*  /index.html  200
